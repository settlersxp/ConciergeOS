# ============================================================================
# Caddy RBAC Gateway Configuration
# ============================================================================
# This Caddy instance sits between oauth2-proxy and the backend API.
# It receives requests WITH the X-Forwarded-Groups header (set by oauth2-proxy)
# and enforces RBAC deny rules pushed by the role-sync service.
#
# Request flow:
#   Client → Caddy(:443) → oidc-api(oauth2-proxy) → caddy-rbac(:4185) → backend
#
# ============================================================================

{
    # Admin API (used by role-sync service to push deny rules)
    admin 0.0.0.0:2020

    # Logging
    log {
        level DEBUG
        output stdout
    }
}

# RBAC gateway — listens on :4185 (internal Docker network only)
:4185 {
    tls internal

    # Default fallback — proxy to backend
    handle {
        reverse_proxy backend:8000 {
            header_up X-Forwarded-By caddy-rbac
            header_up X-Forwarded-Proto http
        }
    }
}